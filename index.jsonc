{
  "name": "aud_midi_apple",
  "summary": "The macOS and iOS backend of aud_midi: CoreMIDI, CoreBluetooth and MIDINetworkSession through FFI.",
  "domain": [
    "Apple MIDI backend"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "backend contracts",
      "aud_midi_standard": "models"
    },
    "usedBy": {
      "aud_midi": "consumes this package"
    }
  }
}
